use crate::tokens::{Token, LexicalError};
use crate::ast;

grammar;

extern {
    type Location = usize;
    type Error = LexicalError;
      
    enum Token {
        "identifier" => Token::Identifier(<String>),
        "int" => Token::Integer(<i64>),
        "(" => Token::LParen,
        ")" => Token::RParen,
        "=" => Token::Assign,
        ";" => Token::Semicolon,
        "+" => Token::OperatorAdd,
        "-" => Token::OperatorSub,
        "*" => Token::OperatorMul,
        "/" => Token::OperatorDiv,
    }

}

pub Program: ast::Program = {
    <stmts: Comma<Statement>> => ast::Program(stmts)
}

// TODO: Should optional trailing semicolon be accepted? For now it is.
Comma<T>: Vec<T> = {
    <mut v:(<T> ";")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
}

pub Statement: ast::Stmt = {
    <start: @L><name:"identifier"> "=" <value:Expression><end: @R> => {
        ast::Stmt {
            kind: ast::Stmt::Assignment { name, value },
            position: SourcePosition(start, end),
        }


    },
    <expr:Expression> => {
        ast::Stmt {
            kind: ast::Stmt::Expression { value: expr }
            position: expr.position,
        }
    },
}

pub Expression: Box<ast::Expr> = {
    #[precedence(level="1")]
    Term,

    #[precedence(level="2")] #[assoc(side="left")]
    <lhs:Expression> "*" <rhs:Expression> => {
        Box::new(
            ast::Expr {
                kind: ast::Expr::BinaryOp {
                    op: ast::BinOp::Mul,
                    lhs,
                    rhs,
                    weight: None,
                },
                position: SourcePosition(lhs.position.0, rhs.position.1),
            }
        )
    },
    <lhs:Expression> "/" <rhs:Expression> => {
        Box::new(
            ast::Expr {
                kind: ast::Expr::BinaryOp {
                    op: ast::BinOp::Div,
                    lhs,
                    rhs,
                    weight: None,
                },
                position: SourcePosition(lhs.position.0, rhs.position.1),
            }
        )
    },

    #[precedence(level="3")] #[assoc(side="right")]
    <lhs:Expression> "+" <rhs:Expression> => {
        Box::new(
            ast::Expr {
                kind: ast::Expr::BinaryOp {
                    op: ast::BinOp::Add,
                    lhs,
                    rhs,
                    weight: None,
                },
                position: SourcePosition(lhs.position.0, rhs.position.1),
            }
        )
    },
    <lhs:Expression> "-" <rhs:Expression> => {
        Box::new(
            ast::Expr {
                kind: ast::Expr::BinaryOp {
                    op: ast::BinOp::Sub,
                    lhs,
                    rhs,
                    weight: None,
                },
                position: SourcePosition(lhs.position.0, rhs.position.1),
            }
        )
    },
}

pub Term: Box<ast::Expr> = {
    <start: @L><val:"int"><end: @R> => {
        Box::new(ast::Expr {
            kind: ast::Expr::Literal(val),
            position: SourcePosition(start, end),
        })


    },
    <start: @L><name:"identifier"><end: @R> => {
        Box::new(ast::Expr {
            kind: ast::Expr::Identifier(name),
            position: SourcePosition(start, end),
        })
    },
    "(" <Expression> ")",
}