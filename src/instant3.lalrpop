use std::str::FromStr;

grammar;

pub Expr: i32 = {
    #[precedence(level="0")]
    Term,
    #[precedence(level="1")] #[assoc(side="left")]
    <l:Expr> "*" <r:Expr> => l * r,
    <l:Expr> "/" <r:Expr> => l / r,
    #[precedence(level="2")] #[assoc(side="left")]
    <l:Expr> "+" <r:Expr> => l + r,
    <l:Expr> "-" <r:Expr> => l - r,
};

pub Term: i32 = {
    <n:Num> => n,
    "(" <e:Expr> ")" => e,
}

Num: i32 = <s:r"[0-9]+"> => i32::from_str(s).unwrap();