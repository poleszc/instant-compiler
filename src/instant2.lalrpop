use std::str::FromStr;

grammar;

pub Expr: i32 = {
    <l:Expr> "+" <r:Factor> => l + r,
    <l:Expr> "-" <r:Factor> => l - r,
    Factor,
};

pub Factor: i32 = {
    <l:Factor> "*" <r:Term> => l * r,
    <l:Factor> "/" <r:Term> => l / r,
    Term,
};

pub Term: i32 = {
    <n:Num> => n,
    "(" <e:Expr> ")" => e,
}

Num: i32 = <s:r"[0-9]+"> => i32::from_str(s).unwrap();